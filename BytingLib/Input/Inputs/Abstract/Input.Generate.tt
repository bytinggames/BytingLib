<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Diagnostics" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Runtime.InteropServices" #>
<#@ output extension=".cs" #>
<#
	string[,] dataTypes = new string[,]
    {
        {"Bool", "bool"},
        {"Int", "int"},
        {"Vector2", "Vector2"},
    };

	string code = File.ReadAllText(Path.Combine(Environment.CurrentDirectory, 
	@"BytingLib\BytingLib\Input\Inputs\Abstract\Input.Source.cs"));

	int beginningIndex = code.IndexOf('{');
	beginningIndex++;
	string beginning = code.Remove(beginningIndex);
	code = code.Substring(beginningIndex);
	int endIndex = code.LastIndexOf('}');
	string end = code.Substring(endIndex);
	code = code.Remove(endIndex);


	string output = "";

	for (int i = 0; i < dataTypes.GetLength(0); i++)
	{
		string c = code;
		c = c.Replace("Float", dataTypes[i, 0]);
		c = c.Replace("float", dataTypes[i, 1]);

		output += c;
	}

	output = beginning + output + end;
#>

<#= output #>
