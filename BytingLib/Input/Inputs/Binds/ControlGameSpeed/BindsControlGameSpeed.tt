<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Diagnostics" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Runtime.InteropServices" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".Generated.cs" #>
// THIS FILE IS GENERATED
namespace BytingLib
{
<#
	string log = "";
	string thisFile = Host.TemplateFile;
	string bindsName = System.IO.Path.GetFileNameWithoutExtension(thisFile);
	string sourceFile = thisFile.Remove(thisFile.Length - 3) + ".cs";
	string code = File.ReadAllText(sourceFile);

	int regionSearchIndex = 0;

	// <region name, containing code>
	Dictionary<string, string> accumulatedRegions = new();
	const string beginStr = "#region >";
	while (true)
	{
		regionSearchIndex = code.IndexOf(beginStr, regionSearchIndex);
		if (regionSearchIndex == -1)
		{
			break;
		}
		regionSearchIndex += beginStr.Length;

		int regionNameEnd = code.IndexOf("\n", regionSearchIndex);
		string regionNameStr = code.Substring(regionSearchIndex, regionNameEnd - regionSearchIndex);
		regionSearchIndex += regionNameStr.Length;
		string[] regionNames = regionNameStr.Trim().Split([' ']);

		int regionLevel = 1;
		int i;
		for (i = regionSearchIndex; i < code.Length; i++)
		{
			if (code[i] == '#')
			{
				if (StartsWithAt(code, "region ", i + 1))
				{
					regionLevel++;
				}
				else if (StartsWithAt(code, "endregion", i + 1))
				{
					regionLevel--;
					if (regionLevel == 0)
					{
						break;
					}
				}
			}
		}

		if (i == code.Length || regionLevel > 0)
		{
			break;
		}

		string regionCode = code.Substring(regionSearchIndex, i - regionSearchIndex);

		foreach (string regionName in regionNames)
		{
			if (!accumulatedRegions.ContainsKey(regionName))
			{
				accumulatedRegions.Add(regionName, regionCode);
			}
			else
			{
				accumulatedRegions[regionName] += "\r\n" + regionCode;
			}
		}
	}

	foreach (var item in accumulatedRegions)
	{
		string regionName = item.Key;
		string regionCode = item.Value;
		List<(string Name, string Type, string? Forwarding)> inputs = new();
		List<(string Name, string Type, string? Forwarding)> values = new();

		//string regionCode = code.Substring(begin, end - begin);
		string[] lines = regionCode.Split(['\n']);
		foreach (string line in lines)
		{
			if (!line.Contains("public"))
			{
				continue;
			}

			// is it forwarding directly?
			string? forwarding = null;
			int forwardArrowIndex = line.IndexOf("=>");
			if (forwardArrowIndex != -1)
			{
				forwardArrowIndex += 2;
				forwarding = line.Substring(forwardArrowIndex).Trim();
				forwarding = forwarding.Replace(";", "");
			}


			const string publicStr = "public ";
			int index = line.IndexOf(publicStr);
			index += publicStr.Length;
			const string inputStr = "Input";
			if (StartsWithAt(line, inputStr, index))
			{
				// Input
				Log(inputStr);
				index += inputStr.Length;
				inputs.Add(GetNameAndType());
			}
			else
			{
				// Value Type
				Log("Value");
				values.Add(GetNameAndType());
			}

			(string, string, string?) GetNameAndType()
			{
				int endIndex = line.IndexOf(' ', index);
				string type = line.Substring(index, endIndex - index);
				index = endIndex + 1;
				endIndex = line.IndexOf(' ', index);
				string name = line.Substring(index, endIndex - index);
				return (name, type, forwarding);
			}
		}

		List<string> privates = new();
		List<string> accessors = new();
		List<string> inits = new();
		List<string> initCalls = new();

		foreach (var input in inputs)
		{
			Log(input.Name + " " + input.Type);

			string forward = input.Forwarding;
			if (forward != null)
			{
				accessors.Add($"public virtual Input{input.Type}State {input.Name} => {forward};");
			}
			else
			{
				string lowercaseName = input.Name[0].ToString().ToLower() + input.Name.Substring(1);
				privates.Add($"protected readonly {input.Type}Func {lowercaseName};");
				accessors.Add($"public virtual Input{input.Type}State {input.Name} => {lowercaseName}.GetState(updater);");
				inits.Add($"InitInput(out {lowercaseName}, new(() => binds.{input.Name}));");
				//initCalls.Add($"InitInput({lowercaseName});");
			}
		}

		foreach (var input in values)
		{
			string forward = input.Forwarding;
			if (forward != null)
			{
				accessors.Add($"public virtual {input.Type} {input.Name} => {forward};");
			}
			else
			{
				string lowercaseName = input.Name[0].ToString().ToLower() + input.Name.Substring(1);
				privates.Add($"protected readonly Func<{input.Type}> {lowercaseName};");
				accessors.Add($"public virtual {input.Type} {input.Name} => {lowercaseName}();");
				inits.Add($"{lowercaseName} = () => binds.{input.Name};");
			}
		}
#>
	// THIS CLASS IS GENERATED by <#= bindsName #>.tt
	public partial class <#= regionName #> : IDisposable
	{
		protected readonly InputUpdater updater;
		protected readonly DisposableContainer disposables = new();

		<#= string.Join("\r\n\t\t", privates) #>

		<#= string.Join("\r\n\t\t", accessors) #>

		public <#= regionName #>(<#=bindsName#> binds, InputUpdater updater)
		{
			this.updater = updater;
			
			<#= string.Join("\r\n\t\t\t", inits) #>

			<#= string.Join("\r\n\t\t\t", initCalls) #>
		}
		
		protected void InitInput<T>(out T inputOut, T input) where T : Input
		{
			updater.AddOutput(input);
			disposables.Use(input);
            inputOut = input;
		}

		public void Dispose()
		{
			disposables.Dispose();
		}
	}
<#
	}
	

	//string output = regionCode;
	//string output = regionName.Trim();
	//string output = code.Substring(begin, end - begin);


	bool StartsWithAt(string str, string value, int index)
	{
		return index >= 0 && index + value.Length <= str.Length &&
			   str.Substring(index).StartsWith(value);
	}
	void Log(string l)
	{
		//log += l + "\n";
	}

	if (log != "")
	{
	log = @$"/*

{log}
*/";
	}
#>
}

<#= log #>